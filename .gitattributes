# Normalize all text files to LF in the repository *and* in the working tree.
# Without this, core.autocrlf=true checks files out as CRLF on Windows, which
# makes `prettier --check` (endOfLine: "lf" by default) fail the pre-push gate
# even though the committed content is already LF.
* text=auto eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
